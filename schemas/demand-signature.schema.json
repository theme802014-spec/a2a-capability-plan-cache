{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-grounded demand record v2",
  "type": "object",
  "required": [
    "schema",
    "extractor_version",
    "request_fingerprint",
    "context_scope",
    "semantic_extraction",
    "execution_effect"
  ],
  "properties": {
    "schema": {
      "const": "planning-demand/v2"
    },
    "extractor_version": {
      "const": "planner-demand-v2"
    },
    "request_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "context_scope": {
      "const": "first_turn_without_external_context"
    },
    "semantic_extraction": {
      "enum": [
        "unavailable",
        "model_extracted_unverified"
      ]
    },
    "execution_effect": {
      "const": "none"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "validation": {
      "const": "structure_and_source_only"
    },
    "record_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "id",
          "operation",
          "target",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "enum": [
              "read",
              "query",
              "consult",
              "analyze",
              "recommend",
              "navigate",
              "compare",
              "other"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "evidence"
        ],
        "properties": {
          "kind": {
            "enum": [
              "current_condition",
              "budget",
              "location",
              "time",
              "prohibition",
              "other"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "stored_profile": {
      "type": "object",
      "required": [
        "usage",
        "evidence"
      ],
      "properties": {
        "usage": {
          "enum": [
            "requested",
            "forbidden",
            "unspecified"
          ]
        },
        "evidence": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ordering": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "before",
          "after",
          "evidence"
        ],
        "properties": {
          "before": {
            "type": "string",
            "minLength": 1
          },
          "after": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "semantic_extraction": {
            "const": "unavailable"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ]
      },
      "else": {
        "required": [
          "goals",
          "constraints",
          "stored_profile",
          "ordering",
          "validation",
          "record_fingerprint"
        ]
      }
    }
  ],
  "additionalProperties": false
}
