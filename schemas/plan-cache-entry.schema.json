{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plan Cache Entry",
  "type": "object",
  "required": [
    "schema",
    "entry_id",
    "original_query",
    "demand_signature",
    "workflow",
    "dependencies",
    "supply_snapshots",
    "plan_fingerprint",
    "revision",
    "status",
    "planner_version"
  ],
  "properties": {
    "schema": {
      "const": "plan-cache-entry/v1"
    },
    "entry_id": {
      "type": "string",
      "minLength": 1
    },
    "original_query": {
      "type": "string",
      "minLength": 1
    },
    "demand_signature": {
      "$ref": "demand-signature.schema.json"
    },
    "workflow": {
      "type": "object",
      "required": [
        "steps"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "inputs",
              "depends_on"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "inputs": {
                "type": "object"
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step_id",
          "domain",
          "capability",
          "skill_id",
          "contract_fingerprint"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "skill_id": {
            "type": "string",
            "minLength": 1
          },
          "contract_fingerprint": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "supply_snapshots": {
      "type": "object",
      "additionalProperties": {
        "$ref": "supply-observation.schema.json"
      }
    },
    "planner_version": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "active",
        "superseded",
        "invalidated"
      ]
    },
    "plan_fingerprint": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
