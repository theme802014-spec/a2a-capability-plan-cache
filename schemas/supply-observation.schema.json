{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized supply observation (not a raw A2A Card)",
  "type": "object",
  "required": [
    "domain",
    "card_version",
    "source_id",
    "observed_at",
    "refresh_status",
    "skills"
  ],
  "properties": {
    "schema": {
      "const": "planning-supply-observation/v1"
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "card_version": {
      "type": "string"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "number"
    },
    "refresh_status": {
      "enum": [
        "ok",
        "failed"
      ]
    },
    "skills": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
